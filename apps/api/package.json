{
  "name": "@aeonic/api",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench:transform": "tsx bench/image-transform.ts",
    "build": "pnpm clean && tsc -b",
    "clean": "node ../../scripts/clean-package.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "auth:schema": "auth generate --config src/auth/schema-config.ts --output src/db/auth-schema.ts --adapter drizzle --dialect sqlite --yes",
    "dev": "tsx watch src/index.ts",
    "dev:ai-worker": "tsx watch src/ai-worker.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "doctor": "node --enable-source-maps dist/doctor.js",
    "start": "node --enable-source-maps dist/index.js",
    "start:ai-worker": "node --enable-source-maps dist/ai-worker.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:s3": "node --import tsx --test test/*s3*.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.bench.json --noEmit"
  },
  "dependencies": {
    "@aeonic/contracts": "workspace:*",
    "@aws-sdk/client-s3": "3.1141.0",
    "@better-auth/api-key": "1.7.6",
    "@better-auth/drizzle-adapter": "1.7.6",
    "@scalar/express-api-reference": "0.10.23",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-auth": "1.7.6",
    "better-sqlite3": "13.0.3",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "sharp": "0.35.4",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "auth": "1.7.3",
    "drizzle-kit": "0.31.10",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
