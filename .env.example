# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# Comma-separated HTTP origins. Production defaults to no cross-origin access.
CORS_ORIGINS=http://localhost:3000

# Enable only behind a trusted reverse proxy.
TRUST_PROXY=false

# Request and lifecycle limits
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
MAX_JSON_BODY_BYTES=1048576

# SQLite control-plane database
DATABASE_PATH=data/aeonic.db
DATABASE_BUSY_TIMEOUT_MS=5000
DATABASE_WAL_AUTOCHECKPOINT_PAGES=1000

# Media storage and simple-upload limits
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=data/objects
UPLOAD_MAX_BYTES=104857600
PROJECT_STORAGE_QUOTA_BYTES=10737418240
UPLOAD_STALE_AFTER_MS=3600000

# S3-compatible backend (required only when STORAGE_BACKEND=s3)
# S3_BUCKET=aeonic-media
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.example.com
# S3_ALLOW_INSECURE_ENDPOINT=false
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=

# Authentication. Generate a production secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=development-only-change-before-production
BETTER_AUTH_URL=http://localhost:3001
