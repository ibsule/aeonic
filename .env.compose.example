# Copy to .env and replace every CHANGE_ME value before first start.
AEONIC_ORIGIN=https://localhost
BETTER_AUTH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DELIVERY_SIGNING_KEYS=primary:CHANGE_ME_WITH_A_32_BYTE_BASE64URL_SECRET
LOG_LEVEL=info
STORAGE_BACKEND=local
PROJECT_STORAGE_QUOTA_BYTES=10737418240

# Optional semantic-search profile. Create these secret files outside version control,
# then start with: docker compose --profile ai up --build
AI_ENABLED=false
AI_PROVIDER=openai
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_VISION_MODEL=CHANGE_ME_EXPLICIT_MODEL_SNAPSHOT
AI_EMBEDDING_MODEL=CHANGE_ME_EXPLICIT_MODEL_SNAPSHOT
AI_EMBEDDING_DIMENSIONS=1536
AI_PIPELINE_VERSION=semantic-v1
AI_INPUT_MICRO_USD_PER_MILLION_UNITS=0
AI_OUTPUT_MICRO_USD_PER_MILLION_UNITS=0
